{% macro heroGraphic() %}
<svg class="hero-graphic" viewBox="0 0 480 380" role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <filter id="heroPanelShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#0f172a" flood-opacity="0.12"></feDropShadow>
    </filter>
  </defs>
  <rect x="0" y="30" width="480" height="340" rx="16" fill="var(--color-surface-0)" stroke="var(--color-border)" filter="url(#heroPanelShadow)"></rect>

  <line x1="32" y1="330" x2="448" y2="330" stroke="var(--color-border)" stroke-width="1"></line>
  <line x1="32" y1="260" x2="448" y2="260" stroke="var(--color-border)" stroke-width="1"></line>
  <line x1="32" y1="190" x2="448" y2="190" stroke="var(--color-border)" stroke-width="1"></line>
  <line x1="32" y1="120" x2="448" y2="120" stroke="var(--color-border)" stroke-width="1"></line>

  <rect class="hero-bar" style="animation-delay:.55s" x="64"  y="230" width="36" height="100" rx="4" fill="var(--color-primary-600)" opacity="0.55"></rect>
  <rect class="hero-bar" style="animation-delay:.65s" x="132" y="180" width="36" height="150" rx="4" fill="var(--color-primary-600)" opacity="0.75"></rect>
  <rect class="hero-bar" style="animation-delay:.75s" x="200" y="140" width="36" height="190" rx="4" fill="var(--color-primary-600)" opacity="0.9"></rect>
  <rect class="hero-bar" style="animation-delay:.85s" x="268" y="200" width="36" height="130" rx="4" fill="var(--color-primary-600)" opacity="0.6"></rect>
  <rect class="hero-bar" style="animation-delay:.95s" x="336" y="160" width="36" height="170" rx="4" fill="var(--color-primary-600)" opacity="0.8"></rect>

  <polyline class="hero-trendline" points="82,210 150,160 218,110 286,175 354,130" fill="none" stroke="var(--color-teal-500)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></polyline>
  <circle class="hero-dot" style="animation-delay:1.3s" cx="82"  cy="210" r="5" fill="var(--color-teal-500)"></circle>
  <circle class="hero-dot" style="animation-delay:1.4s" cx="150" cy="160" r="5" fill="var(--color-teal-500)"></circle>
  <circle class="hero-dot" style="animation-delay:1.5s" cx="218" cy="110" r="5" fill="var(--color-teal-500)"></circle>
  <circle class="hero-dot" style="animation-delay:1.6s" cx="286" cy="175" r="5" fill="var(--color-teal-500)"></circle>
  <circle class="hero-dot" style="animation-delay:1.7s" cx="354" cy="130" r="5" fill="var(--color-teal-500)"></circle>

  <g class="hero-chip" style="animation-delay:.3s">
    <rect x="356" y="0" width="100" height="72" rx="14" fill="var(--color-primary-600)"></rect>
    <g transform="translate(378,16) scale(1.6)" fill="none" stroke="var(--color-on-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
      <polyline points="17 6 23 6 23 12"></polyline>
    </g>
  </g>
</svg>
{% endmacro %}
