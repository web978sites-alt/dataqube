---
layout: layouts/page.njk
---
<div class="container section">
  <h1>{{ title or "Blog" }}</h1>
  <p class="max-w-prose">{{ description }}</p>

  <div class="mt-8">
    {% for post in pagination.items %}
    <div class="post-card">
      <p class="post-meta">{{ post.data.date | dateFriendly }}</p>
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      <p>{{ post.data.description }}</p>
      <div class="mt-2">
        {% for tag in post.data.tags | visibleTags %}
        <a class="tag-pill" href="/blog/tags/{{ tag | slugify }}/">{{ tag }}</a>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>

  <nav class="flex-wrap-gap mt-8" aria-label="Blog pagination">
    {% if pagination.href.previous %}<a class="btn btn--secondary" href="{{ pagination.href.previous }}">&larr; Newer posts</a>{% endif %}
    {% if pagination.href.next %}<a class="btn btn--secondary" href="{{ pagination.href.next }}">Older posts &rarr;</a>{% endif %}
  </nav>
</div>
